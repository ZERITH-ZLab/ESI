{
  "index_root": "/mnt/esi/indexes/training",
  "base_checkpoint": "/mnt/models/robodojo_pi05/59999",
  "norm_stats_dir": "/mnt/esi/norm/training",
  "openpi_source": "/opt/RoboDojo/XPolicyLab/policy/Pi_05/openpi",
  "output": "/mnt/esi/training/8gpu_train_{mode}_run",
  "sampling": {
    "gpt_start_ratio": 0.5,
    "random_ratio": 0.25,
